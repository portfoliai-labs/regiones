#!/usr/bin/env bash
# Publishes the OMI dataset: exports it from praedium's database (DATABASE__URL, as praedium
# reads it), checks it, replaces the `site` branch with it (one commit, no history: GitHub Pages
# serves it at /regiones/v1/) and attaches it to a release named after its latest semester.
#
#   DATABASE__URL=postgresql+asyncpg://... bin/publish <praedium checkout> [--dry-run]
#
# --dry-run exports and checks only, leaving the export's directory to look at.
set -euo pipefail

here="$(cd "$(dirname "$0")/.." && pwd)"
praedium="${1:?the praedium checkout to export with}"
dry_run="${2:-}"
work="$(mktemp -d)"
site="$work/site"
mkdir -p "$site/v1"

echo "Exporting from praedium..."
make -C "$praedium" --no-print-directory omi-dataset out="$site/v1"

# Nothing but JSON, and no tax code (16 characters: 6 letters, 2 digits, a letter, 2 digits, a
# letter, 3 digits, a letter) anywhere: the Agenzia's downloads carry the downloader's.
if find "$site/v1" -type f ! -name '*.json' | grep -q .; then
  echo "Refused: a file that isn't JSON in the export" >&2; exit 1
fi
if grep -rEq '[A-Z]{6}[0-9]{2}[A-Z][0-9]{2}[A-Z][0-9]{3}[A-Z]' "$site/v1"; then
  echo "Refused: something shaped like a tax code in the export" >&2; exit 1
fi

latest="$(python3 -c 'import json,sys; m=json.load(open(sys.argv[1])); s=max(m["semesters"]); print(f"{s//10}-{s%10}")' "$site/v1/manifest.json")"
tag="omi-$latest"
cp "$here/site/index.html" "$site/index.html"
cp "$here/LICENSE-DATA" "$site/LICENSE"
touch "$site/.nojekyll"
tar -czf "$work/regiones-$tag.tar.gz" -C "$site" v1 LICENSE

if [ "$dry_run" = "--dry-run" ]; then
  echo "Dry run: $site ($tag), archive $work/regiones-$tag.tar.gz"; exit 0
fi

remote="$(git -C "$here" remote get-url origin)"
echo "Publishing $tag to the site branch..."
git -C "$site" init -q -b site
git -C "$site" add -A
git -C "$site" -c commit.gpgsign=false commit -q -m "OMI dataset, latest semester $latest"
git -C "$site" push -q --force "$remote" site

if gh release view "$tag" --repo portfoliai-labs/regiones >/dev/null 2>&1; then
  gh release upload "$tag" "$work/regiones-$tag.tar.gz" --clobber --repo portfoliai-labs/regiones
else
  gh release create "$tag" "$work/regiones-$tag.tar.gz" --repo portfoliai-labs/regiones --target main \
    --title "OMI dataset, $latest" \
    --notes "Source: «Agenzia delle Entrate – OMI», CC BY 4.0. The whole dataset up to semester $latest; served at https://portfoliai-labs.github.io/regiones/v1/manifest.json."
fi
rm -rf "$work"
echo "Published $tag."
